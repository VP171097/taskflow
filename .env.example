# Copy this file to ".env" and fill in the values from
# Firebase console → Project settings → General → Your apps → Web app → SDK setup and configuration.
# (These are public identifiers, not secrets. Access is protected by firestore.rules + Authorized domains.)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: change the Gemini model used by the AI features
# VITE_GEMINI_MODEL=gemini-2.5-flash
